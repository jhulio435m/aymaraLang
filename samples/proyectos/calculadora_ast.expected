2 + 3 * 4 => (+ 2 (* 3 4)) = 14
(2 + 3) * (4 - 1) => (* (+ 2 3) (- 4 1)) = 15
2 ^ 3 ^ 2 => (^ 2 (^ 3 2)) = 512
-2 ^ 2 + (-3) ^ 2 => (+ (- (^ 2 2)) (^ (- 3) 2)) = 5
100 / (5 + 5) * 3 - 7 => (- (* (/ 100 (+ 5 5)) 3) 7) = 23
((1+2)*(3+4))^2 - 400 => (- (^ (* (+ 1 2) (+ 3 4)) 2) 400) = 41
