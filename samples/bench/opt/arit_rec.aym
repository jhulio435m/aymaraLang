// Benchmark CPU: aritmetica entera en recursion.
lurawi mezcla(jakhuwi n, jakhuwi a): jakhuwi { kuttaya n < 1 ? a : mezcla(n - 1, (a * 3 + n * 7 - 5) % 1000003 + 2); }
lurawi repite(jakhuwi k, jakhuwi a): jakhuwi { kuttaya k < 1 ? a : repite(k - 1, mezcla(20000, a + k)); }
qillqa(repite(2000, 1));
