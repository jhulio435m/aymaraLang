// Ordenamiento burbuja: compara vecinos e intercambia hasta ordenar la lista.
qallta
yatiya t'aqa xs = [5, 2, 9, 1, 7, 3];
yatiya jakhüwi n = suyut(xs);
kuti(yatiya jakhüwi i = 0; i < n - 1; i = i + 1) {
  kuti(yatiya jakhüwi j = 0; j < n - 1 - i; j = j + 1) {
    ukaxa(xs[j] > xs[j + 1]) {
      yatiya jakhüwi t = xs[j];
      xs[j] = xs[j + 1];
      xs[j + 1] = t;
    }
  }
}
qillqa(xs);
tukuya
