// Cloudflare Workers: sirve el sitio estático que `next build` deja en out/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aymaralang",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "aymaralang.soryntel.com", "custom_domain": true }]
}
