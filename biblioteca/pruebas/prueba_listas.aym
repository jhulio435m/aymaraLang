apnaq("../listas");
yatiya t'aqa xs = [5, 3, 8, 3, 1];
qillqa(l_invertir(xs));
qillqa(l_indice(xs, 8));
qillqa(l_indice(xs, 99));
qillqa(l_contiene(xs, 1) ? "si" : "no");
qillqa(l_rebanada(xs, 1, 3));
qillqa(l_min(xs));
qillqa(l_max(xs));
qillqa(l_suma(xs));
qillqa(l_unicos(xs));
yatiya t'aqa o = l_ordenar(xs);
qillqa(o);
qillqa(l_busqueda_binaria(o, 5));
qillqa(l_busqueda_binaria(o, 4));
qillqa(l_rango(2, 6));
qillqa(l_concatenar([1, 2], [3]));
qillqa(xs);
yatiya t'aqa q1 = l_quicksort(xs);
qillqa(q1);
qillqa(xs);
qillqa(l_quicksort([]));
qillqa(l_quicksort([7]));
qillqa(l_quicksort([4, 0 - 1, 4, 2, 0, 0 - 5]));
qillqa(l_producto_punto([1, 2, 3], [4, 5, 6]));
qillqa(l_producto_punto([], []));
yant'aña {
  qillqa(l_producto_punto([1, 2], [3]));
} katjaña("ARG", e) {
  qillqa(e.suti);
}
qillqa(l_filtrar_positivos([0 - 3, 0, 5, 0 - 1, 2, 0, 8]));
qillqa(l_filtrar_positivos([0 - 2, 0]));
qillqa(l_aplanar_pares([1, 2, 3], [4, 5, 6]));
qillqa(l_aplanar_pares([1, 2, 3], [10, 20]));
qillqa(l_aplanar_pares([], [1, 2]));
