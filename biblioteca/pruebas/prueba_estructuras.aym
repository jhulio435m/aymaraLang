apnaq("../estructuras");
yatiya Pila p = machaqa Pila();
p.apilar(1); p.apilar(2); p.apilar(3);
qillqa(p.cima());
qillqa(p.desapilar());
qillqa(p.tamano());
qillqa(p.vacia() ? "vacia" : "con datos");
yatiya Cola c = machaqa Cola();
c.encolar(10); c.encolar(20);
qillqa(c.frente());
qillqa(c.desencolar());
qillqa(c.tamano());
qillqa(c.desencolar());
qillqa(c.vacia() ? "vacia" : "con datos");
yatiya Conjunto s = machaqa Conjunto();
s.agregar("a"); s.agregar("b"); s.agregar("a");
qillqa(s.tamano());
qillqa(s.contiene("b") ? "si" : "no");
s.quitar("b");
qillqa(s.contiene("b") ? "si" : "no");
yatiya ContadorMapa k = machaqa ContadorMapa();
k.contar("x"); k.contar("y"); k.contar("x");
qillqa(k.cuenta("x"));
qillqa(k.cuenta("z"));
qillqa(k.distintos());
yatiya ListaEnlazada le = machaqa ListaEnlazada();
qillqa(le.tamano());
yatiya t'aqa vacia_le = le.a_lista();
qillqa(vacia_le);
qillqa(le.contiene(10) ? "si" : "no");
le.insertar_final(20);
le.insertar_inicio(10);
le.insertar_final(30);
le.insertar_inicio(5);
qillqa(le.tamano());
yatiya t'aqa elems_le = le.a_lista();
qillqa(elems_le);
qillqa(le.contiene(20) ? "si" : "no");
qillqa(le.contiene(99) ? "si" : "no");
yatiya ListaEnlazada le2 = machaqa ListaEnlazada();
le2.insertar_inicio(7);
le2.insertar_final(9);
yatiya t'aqa elems_le2 = le2.a_lista();
qillqa(elems_le2);
