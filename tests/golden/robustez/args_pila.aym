lurawi muchos(jakhüwi a, jakhüwi b, jakhüwi c, jakhüwi d, jakhüwi e, jakhüwi f, jakhüwi g, jakhüwi h): jakhüwi {
  kuttaya a + b*2 + c*3 + d*4 + e*5 + f*6 + g*7 + h*8;
}
qillqa(muchos(1, 1, 1, 1, 1, 1, 1, 1));
qillqa(muchos(1, 2, 3, 4, 5, 6, 7, 8));
lurawi cadenas(aru a, aru b, aru c, aru d, aru e, aru f, aru g): aru {
  kuttaya a + b + c + d + e + f + g;
}
qillqa(cadenas("a", "b", "c", "d", "e", "f", "g"));
// anidada: argumento extra que a su vez hace una llamada con extras
qillqa(muchos(1, 0, 0, 0, 0, 0, muchos(1, 0, 0, 0, 0, 0, 0, 1), 2));
lurawi siete(jakhüwi a, jakhüwi b, jakhüwi c, jakhüwi d, jakhüwi e, jakhüwi f, jakhüwi g = 100): jakhüwi {
  kuttaya a + b + c + d + e + f + g;
}
qillqa(siete(1, 1, 1, 1, 1, 1));
kasta Caja {
  yatiya jakhüwi base;
  qallta(jakhüwi a, jakhüwi b, jakhüwi c, jakhüwi d, jakhüwi e, jakhüwi f, jakhüwi g) {
    aka.base = a + b + c + d + e + f + g * 10;
  }
  lurawi suma(jakhüwi a, jakhüwi b, jakhüwi c, jakhüwi d, jakhüwi e, jakhüwi f, jakhüwi g): jakhüwi {
    kuttaya aka.base + a + b + c + d + e + f + g * 100;
  }
  sapakasta lurawi est(jakhüwi a, jakhüwi b, jakhüwi c, jakhüwi d, jakhüwi e, jakhüwi f, jakhüwi g): jakhüwi {
    kuttaya a + g * 1000;
  }
}
yatiya Caja k = machaqa Caja(1, 1, 1, 1, 1, 1, 1);
qillqa(k.base);
qillqa(k.suma(1, 1, 1, 1, 1, 1, 1));
qillqa(k.suma(0, 0, 0, 0, 0, 0, k.suma(0, 0, 0, 0, 0, 0, 1)));
qillqa(Caja.est(1, 0, 0, 0, 0, 0, 2));
