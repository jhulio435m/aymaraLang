yatiya chikata pi = 3.14159;
qillqa(pi);
qillqa(7.5 / 2);
qillqa(0.1 + 0.2);
qillqa(1.0);
qillqa(2 * pi);
yatiya chikata r = 2;
qillqa(r);
qillqa(r * r * pi);
qillqa(7 / 2);
qillqa(7 / 2.0);
qillqa(-2.5);
qillqa(-pi);
qillqa(1e3);
qillqa(2.5e-3);
qillqa(1.5 < 2);
qillqa(2 == 2.0);
qillqa(2.5 != 2.5);
qillqa(10.5 % 3);
qillqa(2.0 ^ 0.5);
qillqa(sqrt(81));
qillqa(sqrt(2));
qillqa(floor(2.7) + 1);
qillqa(round(-2.5));
qillqa(jakhüwi(9.99));
qillqa(chikata(3));
qillqa(chikata("2.75") * 2);
qillqa(aru(1.25) + "!");
qillqa(1.0 / 0);
qillqa(sqrt(-1));
yatiya chikata x = 0.5;
x += 1;
x++;
qillqa(x);
x = x * 2;
qillqa(x);
yatiya t'aqa<chikata> v = [1.5, 2, 3.25];
qillqa(v);
qillqa(v[1] + 0.5);
yatiya t'aqa<chikata> w = [1, 2, 3];
qillqa(w);
yatiya mapa m = {"a": 1.5, "b": 2};
qillqa(m);
qillqa(m["a"]);
qillqa(5 > 3 ? 1.5 : 2);
